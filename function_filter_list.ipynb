   "source": [
    "def function_filter_list(userList, threshold):\n",
    "  newList = []\n",
    "\n",
    "  for element in userList:\n",
    "    if element <= threshold:\n",
    "      newList.append(element)\n",
    "\n",
    "  return newList\n",
    "\n",
    "print(function_filter_list([1, 2, 3, 2, 0], 2))"
   ]
